# サプライチェーン攻撃への対策（npm 11.19 以降）

# 公開から 7 日経っていないバージョンは新たにインストールしない
# （乗っ取られたパッケージの悪意あるバージョンは、多くの場合数日以内に発見・削除されるため）
min-release-age=7

# 依存パッケージの install スクリプト（preinstall / install / postinstall）は、
# package.json の allowScripts で許可したものだけを実行し、未確認のものがあればインストールを失敗させる
strict-allow-scripts=true

# バージョンを固定して追加する（^ を付けない）
save-exact=true
